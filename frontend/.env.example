# =============================================================================
# FRONTEND ENVIRONMENT TEMPLATE
#
# Committed to Git. Contains NO secrets, and never should.
#
# Setup:  copy this file to `.env`
#     copy .env.example .env      (Windows CMD)
#     cp .env.example .env        (macOS/Linux)
# =============================================================================

# Base URL of the Express API, including the /api prefix.
#
# Local backend:  http://localhost:5000/api
# Production:     https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# WHAT MUST NEVER GO IN THIS FILE
#
# Vite REPLACES import.meta.env.VITE_* with literal values at build time.
# Those values end up in the JavaScript bundle served to every visitor,
# where anyone can read them with View Source. The VITE_ prefix is a
# safety rail: variables without it are not exposed at all.
#
# So the following belong ONLY in backend/.env, never here:
#   JWT_SECRET       — anyone holding it can forge a token for any user
#   MONGODB_URI      — full read/write access to the database
#   IMAGEKIT_PRIVATE_KEY - full read/write access to the media library
#   mail credentials, or any other third-party API secret
#
# An API URL is safe because the browser must know it to send requests.
# -----------------------------------------------------------------------------
