# =============================================================================
# ENVIRONMENT VARIABLE TEMPLATE
#
# This file IS committed to Git. It contains NO real secrets.
#
# It exists so a new developer knows exactly which variables the app needs.
# Setup:  copy this file to `.env`, then fill in real values.
#
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env      (Windows CMD)
#
# RULE: whenever you add a variable to .env, add the KEY here too —
# with a placeholder value, never the real one.
# =============================================================================

# Port the HTTP server listens on.
PORT=5000

# "development" or "production".
NODE_ENV=development

# MongoDB connection string.
#
# Local MongoDB:
#   mongodb://127.0.0.1:27017/campus_lost_found
#
# MongoDB Atlas (production) — NEVER paste a real one into this file:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_lost_found
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found
