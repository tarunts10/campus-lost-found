# =============================================================================
# ENVIRONMENT VARIABLE TEMPLATE
#
# This file IS committed to Git. It contains NO real secrets.
#
# Setup:  copy this file to `.env`, then fill in real values.
#     copy .env.example .env      (Windows CMD)
#     cp .env.example .env        (macOS/Linux)
#
# RULE: whenever you add a variable to .env, add the KEY here too —
# with a placeholder value, never the real one.
# =============================================================================

# --- Server ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database ----------------------------------------------------------
# Local MongoDB:
#   mongodb://127.0.0.1:27017/campus_lost_found
# MongoDB Atlas (production) — NEVER paste a real one into this file:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_lost_found
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found

# --- Authentication ----------------------------------------------------
# Secret used to sign and verify JWTs.
#
# WARNING: anyone holding this value can forge a token for ANY user,
# including an admin. Never commit a real one. Never reuse the dev value
# in production. Generate a fresh, random secret per environment:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# How long an issued token stays valid. Accepts "15m", "24h", "7d".
JWT_EXPIRES_IN=7d

# --- Security ----------------------------------------------------------
# Max requests to /api/auth/* per IP per 15 minutes.
# Raise locally if testing; keep low (around 20) in production.
AUTH_RATE_LIMIT_MAX=20

# Which browser origin may call this API.
# Local Vite dev server:  http://localhost:5173
# Production:             https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173
