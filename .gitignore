# =============================================================================
# .gitignore  —  files Git must NEVER track
#
# One pattern per line. A trailing "/" means "this is a directory".
# Patterns here apply to this folder and every folder beneath it,
# so this single file covers both frontend/ and backend/.
# =============================================================================


# --- Secrets --------------------------------------------------------
# NEVER commit these. A leaked DB connection string or JWT secret is
# compromised permanently, because Git keeps history forever.
# Commit .env.example (fake values) instead, so others know what to fill in.
.env
.env.local
.env.*.local
*.pem
*.key


# --- Dependencies ---------------------------------------------------
# Reproducible from package.json + package-lock.json via `npm install`.
# Huge, platform-specific, and would make every diff unreadable.
node_modules/
.pnp
.pnp.js


# --- Build output ---------------------------------------------------
# Generated from source on every build/deploy. Never the source of truth.
dist/
build/
*.tsbuildinfo


# --- Logs -----------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# --- Uploaded / temporary files -------------------------------------
# Item photos are handled by Multer before going to ImageKit.
# Anything landing on local disk is scratch data, not source code.
uploads/
tmp/
temp/


# --- Test & coverage output -----------------------------------------
coverage/
.nyc_output/


# --- Deployment platform caches -------------------------------------
.vercel
.render


# --- Editor & OS noise ----------------------------------------------
# Personal to one machine; does not belong in shared history.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
